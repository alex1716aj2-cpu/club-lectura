# --- PostgreSQL ---
POSTGRES_USER=club
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=club_lectura

# --- Backend ---
# Dentro de Docker el host de la base es "db" (nombre del servicio en docker-compose)
DATABASE_URL=postgresql://club:cambia_esta_contrasena@db:5432/club_lectura?schema=public
JWT_SECRET=reemplaza_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=1d
COOKIE_SECURE=false
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend ---
# URL del backend vista desde el NAVEGADOR
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL del backend vista desde el contenedor del frontend (render en servidor)
INTERNAL_API_URL=http://backend:4000
